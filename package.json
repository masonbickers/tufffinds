{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "email:launch": "node functions/scripts/launch-email-campaign.js --dry-run",
    "email:launch:retry-failed": "node functions/scripts/launch-email-campaign.js --retry-failed",
    "email:launch:send": "node functions/scripts/launch-email-campaign.js --send",
    "email:launch:test": "node functions/scripts/launch-email-campaign.js --test",
    "email:preview:launch": "node scripts/preview-launch-email.js",
    "email:preview:welcome": "node scripts/preview-welcome-email.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "lint:raw": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "next": "15.5.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.23",
    "baseline-browser-mapping": "^2.10.16",
    "eslint": "^9",
    "eslint-config-next": "^15.5.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
